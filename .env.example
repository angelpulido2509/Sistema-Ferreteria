# FerrePro — variables de entorno (copiar a .env en la raíz del monorepo).
# Es el ÚNICO .env que carga la API (apps/api/src/config/dotenv.ts).
# Nunca commitear el .env real.

# development | test | production  (por defecto: production)
NODE_ENV=production
PORT=4000

# local (SQLite en esta PC) | cloud (PostgreSQL en la nube)
RUNTIME_MODE=local
# SQLite: ruta relativa a prisma/ (schema.local.prisma)
DATABASE_URL="file:./ferreteria.db"

# Secretos OBLIGATORIOS: mínimo 32 caracteres, sin cadenas de desarrollo.
# Genéralos con:  node scripts/generate-secrets.mjs
JWT_SECRET="<pegar-valor-generado>"
JWT_REFRESH_SECRET="<pegar-valor-generado-distinto>"
SYNC_API_KEY="<pegar-valor-generado-igual-en-local-y-nube>"

# Access token: máximo 30 min (valores mayores se acotan)
JWT_EXPIRES_IN="30m"
JWT_REFRESH_EXPIRES_IN="7d"

# Orígenes permitidos por CORS, separados por comas (ver docs/ACCESO-REMOTO.md)
CORS_ORIGIN="http://localhost:5173"

# URL de la API en la nube para la sincronización (vacío = sin sincronizar)
CLOUD_API_URL=""

# Respaldos automáticos de SQLite (al iniciar, al cerrar turno y diario). Recomendado: otro disco o USB.
# Vacío = prisma/backups
BACKUP_DIR=""
BACKUP_RETENTION_DAYS=30

# Cookie del refresh token con atributo Secure (por defecto: true en producción).
# Ponla en false solo si accedes por http desde otro equipo de la LAN.
# COOKIE_SECURE=false
